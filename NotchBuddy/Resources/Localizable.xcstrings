            "value" : "Coucou ليس في مجلد التطبيقات، لذا لا يمكنه استبدال نفسه: احصل على الإصدار الجديد من GitHub."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou আপনার Applications ফোল্ডারে নেই, তাই নিজেকে বদলাতে পারে না: নতুন সংস্করণ GitHub থেকে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou liegt nicht in deinem Programme-Ordner und kann sich daher nicht selbst ersetzen: Hol dir die neue Version auf GitHub."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou isn’t in your Applications folder, so it can’t replace itself: get the new version on GitHub."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou no está en tu carpeta Aplicaciones, así que no puede reemplazarse: descarga la nueva versión en GitHub."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou n’est pas dans ton dossier Applications, il ne peut donc pas se remplacer : récupère la nouvelle version sur GitHub."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou आपके Applications फ़ोल्डर में नहीं है, इसलिए खुद को बदल नहीं सकता: नया वर्ज़न GitHub से लें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou tidak ada di folder Aplikasi, jadi tidak bisa mengganti dirinya: ambil versi baru di GitHub."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Coucou não está na sua pasta Aplicativos, então não pode se substituir: baixe a nova versão no GitHub."
          }
