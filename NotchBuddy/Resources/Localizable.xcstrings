    "portfolio.error.coinbase-key" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser private Schlüssel kann nicht gelesen werden. Füge den gesamten Schlüssel von BEGIN EC PRIVATE KEY bis END EC PRIVATE KEY ein (ECDSA-Schlüssel)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This private key can't be read. Paste the whole key, from BEGIN EC PRIVATE KEY to END EC PRIVATE KEY (ECDSA key)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette clé privée est illisible. Colle toute la clé, de BEGIN EC PRIVATE KEY à END EC PRIVATE KEY (clé ECDSA)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านคีย์ส่วนตัวนี้ไม่ได้ วางคีย์ทั้งหมดตั้งแต่ BEGIN EC PRIVATE KEY ถึง END EC PRIVATE KEY (คีย์ ECDSA)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu özel anahtar okunamıyor. BEGIN EC PRIVATE KEY ile END EC PRIVATE KEY arasındaki anahtarın tamamını yapıştır (ECDSA anahtarı)."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取此私鑰。請貼上完整的金鑰，從 BEGIN EC PRIVATE KEY 到 END EC PRIVATE KEY（ECDSA 金鑰）。"
          }
        }
      }
    },
    "portfolio.instructions.coinbase" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle unter coinbase.com → Einstellungen → API (CDP) → API-Schlüssel erstellen die Signatur ECDSA und nur die Berechtigung View. Füge den Schlüsselnamen (organizations/…/apiKeys/…) und den gesamten privaten Schlüssel (BEGIN EC PRIVATE KEY…) ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On coinbase.com → Settings → API (CDP) → Create API key, signature ECDSA, permission View only. Paste the key name (organizations/…/apiKeys/…) and the whole private key (BEGIN EC PRIVATE KEY…)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur coinbase.com → Paramètres → API (CDP) → Créer une clé API, signature ECDSA, permission Lecture (View) uniquement. Colle le nom de la clé (organizations/…/apiKeys/…) et toute la clé privée (BEGIN EC PRIVATE KEY…)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่ coinbase.com → Settings → API (CDP) → Create API key เลือกลายเซ็น ECDSA และสิทธิ์ View only วางชื่อคีย์ (organizations/…/apiKeys/…) และคีย์ส่วนตัวทั้งหมด (BEGIN EC PRIVATE KEY…)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "coinbase.com → Ayarlar → API (CDP) → API anahtarı oluştur bölümünde ECDSA imzasını ve yalnızca View iznini seç. Anahtar adını (organizations/…/apiKeys/…) ve özel anahtarın tamamını (BEGIN EC PRIVATE KEY…) yapıştır."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 coinbase.com → 設定 → API（CDP）→ 建立 API 金鑰，選擇 ECDSA 簽章及僅檢視（View）權限。貼上金鑰名稱（organizations/…/apiKeys/…）及完整的私鑰（BEGIN EC PRIVATE KEY…）。"
          }
        }
      }
    },
