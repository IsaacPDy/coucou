    "alerts.all-pills.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما تنتهي حبة غير المعروضة أو تواجه خطأ، يعرضها النوتش لحظة ثم تعود حبتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দেখানো পিল ছাড়া অন্য কোনো পিল শেষ হলে বা ত্রুটি হলে, নচ সেটি কিছুক্ষণ দেখায়, তারপর আপনার পিল ফিরে আসে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine andere Pill als die angezeigte fertig wird oder auf einen Fehler stößt, zeigt die Notch sie kurz an, dann kehrt deine Pill zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a pill other than the one shown finishes or hits an error, the notch shows it for a moment, then the pill you had comes back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando otra píldora distinta de la mostrada termina o da un error, el notch la muestra un momento y luego vuelve la tuya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand une autre pill que celle affichée termine ou rencontre une erreur, le notch l’affiche un instant, puis ta pill revient."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब दिखाई जा रही पिल के अलावा कोई और पिल पूरी हो या उसमें गड़बड़ी हो, तो नॉच उसे थोड़ी देर दिखाता है, फिर आपकी पिल वापस आ जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat pil selain yang ditampilkan selesai atau mengalami galat, notch menampilkannya sebentar, lalu pilmu kembali."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando outra pílula que não a exibida termina ou dá erro, o notch a mostra por um instante e depois a sua volta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда другая пилюля, не та что показана, завершает работу или получает ошибку, вырез ненадолго показывает её, затем возвращается ваша."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อแถบอื่นที่ไม่ได้แสดงอยู่ทำงานเสร็จหรือเกิดข้อผิดพลาด แถบด้านบนจะแสดงแถบนั้นสักครู่ แล้วจึงกลับมาที่แถบเดิมของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gösterilenden başka bir araç bittiğinde veya bir hatayla karşılaştığında ada onu kısa bir süre gösterir, sonra kendi aracın geri gelir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当非当前显示的胶囊完成或出错时，刘海会短暂显示它，然后回到你原来的胶囊。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當非目前顯示的標籤完成或發生錯誤時，瀏海會短暫顯示它，然後回到你原本的標籤。"
          }
        }
      }
    },
    "claude-desktop.chat.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للدردشات العادية في تطبيق Claude التي لا تملك hook. عندما تغادر Claude أثناء الكتابة، يتحقق Coucou كل ثانية عبر تسهيلات الاستخدام من بقاء زر الإيقاف. لا يُقرأ أي شيء من الدردشة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude অ্যাপের সাধারণ চ্যাটের জন্য, যেগুলোতে কোনো হুক নেই। Claude লেখার সময় আপনি সরে গেলে, Coucou প্রতি সেকেন্ডে Accessibility দিয়ে দেখে তার Stop বোতাম এখনও আছে কি না। চ্যাটের কিছুই পড়া হয় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für normale Chats in der Claude-App, die keinen Hook ausführen. Wenn du Claude verlässt, während es schreibt, prüft Coucou einmal pro Sekunde über die Bedienungshilfen, ob die Stopp-Taste noch da ist. Vom Chat wird nichts gelesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For regular chats in the Claude app, which run no hook. When you leave Claude while it is writing, Coucou checks once a second, through Accessibility, whether its Stop button is still there. Nothing of the chat is read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para los chats normales de la app Claude, que no tienen hook. Cuando sales de Claude mientras escribe, Coucou comprueba cada segundo, mediante Accesibilidad, si su botón Detener sigue ahí. No se lee nada del chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les chats classiques de l’app Claude, qui n’ont pas de hook. Quand tu quittes Claude pendant qu’il écrit, Coucou vérifie chaque seconde, via l’Accessibilité, si son bouton Stop est encore là. Rien du chat n’est lu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude ऐप की सामान्य चैट के लिए, जिनमें कोई हुक नहीं होता। Claude के लिखते समय आप उसे छोड़ें, तो Coucou हर सेकंड Accessibility से देखता है कि उसका Stop बटन अब भी है या नहीं। चैट का कुछ भी नहीं पढ़ा जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk chat biasa di aplikasi Claude, yang tidak punya hook. Saat kamu meninggalkan Claude ketika ia sedang menulis, Coucou memeriksa setiap detik lewat Aksesibilitas apakah tombol Stop-nya masih ada. Isi chat tidak dibaca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para os chats comuns do app Claude, que não têm hook. Quando você sai do Claude enquanto ele escreve, o Coucou verifica a cada segundo, pela Acessibilidade, se o botão Parar ainda está lá. Nada do chat é lido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для обычных чатов в приложении Claude, где нет хуков. Когда вы уходите из Claude, пока он пишет, Coucou раз в секунду через Универсальный доступ проверяет, есть ли ещё кнопка «Стоп». Содержимое чата не читается."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สำหรับแชตทั่วไปในแอป Claude ซึ่งไม่มี hook เมื่อคุณออกจาก Claude ระหว่างที่กำลังเขียน Coucou จะตรวจสอบทุกวินาทีผ่านการช่วยการเข้าถึงว่าปุ่มหยุดยังอยู่หรือไม่ ไม่มีการอ่านเนื้อหาแชตใด ๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude uygulamasındaki, hook çalıştırmayan normal sohbetler için. Claude yazarken ondan ayrılırsan Coucou, Erişilebilirlik üzerinden saniyede bir Durdur düğmesinin hâlâ orada olup olmadığını kontrol eder. Sohbetten hiçbir şey okunmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于 Claude 应用中的普通聊天（没有 hook）。当 Claude 正在输出时你离开它，Coucou 会每秒通过辅助功能检查“停止”按钮是否还在。不会读取任何聊天内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "適用於 Claude App 中的一般聊天（不會執行 hook）。當 Claude 正在輸出時你離開它，Coucou 會每秒透過「輔助使用」檢查「停止」按鈕是否還在。不會讀取任何聊天內容。"
          }
        }
      }
    },
    "claude-desktop.chat.needs-accessibility" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح لـ Coucou في إعدادات النظام › الخصوصية والأمن › تسهيلات الاستخدام."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Settings › Privacy & Security › Accessibility-এ Coucou-কে অনুমতি দিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Coucou unter Systemeinstellungen › Datenschutz & Sicherheit › Bedienungshilfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Coucou in System Settings › Privacy & Security › Accessibility."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite Coucou en Ajustes del Sistema › Privacidad y seguridad › Accesibilidad."
          }
        },
        "fr" : {
